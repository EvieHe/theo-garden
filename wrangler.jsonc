{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "theo-garden",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-10",
  "keep_vars": true,
  "secrets": {
    "required": ["SITE_PASS", "SESSION_SECRET", "GITHUB_TOKEN"]
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
